# Book RAG server environment. Copy to .env in the project root and fill in.

# --- answering backend -----------------------------------------------------
BOOKRAG_LLM_PROVIDER=openai
# If the app runs on the same machine as vLLM, prefer localhost: it skips the
# network hop entirely.
BOOKRAG_LLM_BASE_URL=http://127.0.0.1:8000/v1
BOOKRAG_LLM_MODEL=Qwen/Qwen3-32B-AWQ
BOOKRAG_LLM_FAST_MODEL=
BOOKRAG_LLM_API_KEY=
# Qwen3 thinks out loud unless told not to; measured 0.5 s vs minutes per reply.
BOOKRAG_LLM_ENABLE_THINKING=false
# response_format=json_object stalled vLLM 0.28 in testing; the prompt plus the
# JSON repair loop is used instead.
BOOKRAG_LLM_JSON_MODE=false
# Nothing to fall back to unless Ollama runs alongside the app.
BOOKRAG_LLM_FALLBACK=false

# --- web app ---------------------------------------------------------------
# REQUIRED: the app refuses to serve a network address without it.
BOOKRAG_APP_PASSWORD=
BOOKRAG_LOG_LEVEL=INFO

# --- storage ---------------------------------------------------------------
# Model weights (~4.6 GB) and the index must live on a persistent disk.
HF_HOME=/opt/bookrag/.hf
