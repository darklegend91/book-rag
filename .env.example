# ---------------------------------------------------------------------------
# Book-RAG environment. Copy to .env and fill in.
#   cp .env.example .env
#
# config.yaml reads these as ${VAR:-default}. A real shell variable beats the
# file, so you can override for a single run without editing anything:
#   BOOKRAG_LLM_PROVIDER=ollama streamlit run app.py
# ---------------------------------------------------------------------------

# Which backend answers questions: openai | ollama
#   openai = any OpenAI-compatible server (vLLM, llama.cpp server, LM Studio,
#            LocalAI, text-generation-webui, or Ollama's own /v1 endpoint)
BOOKRAG_LLM_PROVIDER=openai

# --- your server -----------------------------------------------------------
# Must include the /v1 suffix. Examples:
#   vLLM / LocalAI / text-generation-webui : http://localhost:8000/v1
#   llama.cpp server                       : http://localhost:8080/v1
#   LM Studio                              : http://localhost:1234/v1
#   Ollama's OpenAI shim                   : http://localhost:11434/v1
#   another machine on your network        : http://192.168.1.42:8000/v1
BOOKRAG_LLM_BASE_URL=http://localhost:8000/v1

# The model id your server advertises at GET <base_url>/models.
BOOKRAG_LLM_MODEL=

# Optional: a cheaper model on the same server for PYQ parsing and paper
# scaffolding. Leave blank to reuse BOOKRAG_LLM_MODEL.
BOOKRAG_LLM_FAST_MODEL=

# Optional: most local servers ignore this. Set it if yours wants a bearer
# token. This file is gitignored -- keep real secrets here, never in config.yaml.
BOOKRAG_LLM_API_KEY=

# Reasoning models (Qwen3 etc.) on vLLM/SGLang: `false` turns off the inline
# <think> output. Leave empty for servers that reject unknown request fields.
BOOKRAG_LLM_ENABLE_THINKING=

# `false` stops sending response_format=json_object, for servers where
# constrained JSON decoding is slow or stalls. JSON is then prompt-enforced.
BOOKRAG_LLM_JSON_MODE=true

# --- fallback --------------------------------------------------------------
# When the server above is unreachable, retry the call on this backend instead
# of failing the question. Per-call: your server is used again the moment it
# comes back, with no restart.
BOOKRAG_LLM_FALLBACK=true
BOOKRAG_LLM_FALLBACK_PROVIDER=ollama
BOOKRAG_OLLAMA_HOST=http://localhost:11434

# --- web app ---------------------------------------------------------------
# Required if the Streamlit app is served beyond this machine (see
# .streamlit/config.toml). Leave empty for local-only use.
BOOKRAG_APP_PASSWORD=
